FROM dxflrs/garage:v2.4.1@sha256:9c96caa2612d3411acc5b0e6701fb238dbfba33e533a6d7d3d811a4b12d0d020 AS garage
FROM litestream/litestream:0.5.14@sha256:ef0ac5958cf81725b7a85fb76f82ef71ace030db9429086eeefc59ee6ca53941
COPY --from=garage /garage /garage
RUN addgroup --system --gid 10002 garage \
    && adduser --system --uid 10002 --ingroup garage --no-create-home garage \
    && mkdir -p /var/lib/garage /var/lib/garage-secrets \
    && chown garage:garage /var/lib/garage /var/lib/garage-secrets \
    && chmod 700 /var/lib/garage /var/lib/garage-secrets
COPY --chmod=755 release-permissions.sh /usr/local/bin/release-permissions.sh
USER 10002:10002
