{
  "name": "ocazbike-spa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run styles:build && bun --watch src/index.ts",
    "build": "bun run styles:build && bun run build.ts",
    "start": "NODE_ENV=production bun server.ts",
    "styles:build": "bunx @tailwindcss/cli -i ./src/shared/styles/tailwind.css -o ./src/shared/styles/tailwind.generated.css --minify",
    "test": "bun test --reporter=dots",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-router": "^1.170.46",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "i18next": "^26.4.0",
    "libphonenumber-js": "^1.12.0",
    "lucide-react": "^1.48.0",
    "react": "^19",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19",
    "react-i18next": "^17.0.12",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@tailwindcss/cli": "^4.3.3",
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [
    "@parcel/watcher"
  ]
}
