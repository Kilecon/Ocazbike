{
  "name": "da",
  "version": "1.0.50",
  "scripts": {
    "test": "bun test src",
    "test:unit": "bun test ",
    "test:user-contract": "bun test src/features/auth/test/contract",
    "test:user-integration": "bun test src/features/auth/test/integration",
    "test:db-performance": "bun test src/features/auth/test/performance/database.test.ts",
    "test:clients-unit": "bun test src/features/clients/test/unit",
    "test:clients-contract": "bun test src/features/clients/test/contract",
    "test:clients-integration": "bun test src/features/clients/test/integration",
    "test:clients-performance": "bun test src/features/clients/test/performance/database.test.ts",
    "test:watch": "bun test src --watch",
    "dev": "bun run --watch src/server.ts",
