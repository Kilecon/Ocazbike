    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@types/bcrypt": "^6.0.0",
    "bcrypt": "^6.0.0",
    "drizzle-orm": "^0.45.4",
    "elysia": "latest",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
