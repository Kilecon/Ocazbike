SQLITE_DB_PATH=./data/elysia.sqlite
BOOTSTRAP_ADMIN_PASSWORD=
ENCRYPTION_KEY=
# STORE_INFORMATION_INITIAL_DATA={"name":"...","address":"...","phone":"...","secondaryPhone":"...","email":"...","siret":"...","apeCode":"...","vatNumber":"...","bankName":"...","iban":"...","bic":"..."}
STORE_INFORMATION_INITIAL_DATA=
GARAGE_RPC_SECRET=
GARAGE_DEFAULT_ACCESS_KEY=
GARAGE_DEFAULT_SECRET_KEY=

JWT_SECRET=
SPA_APP_ID=my-spa
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
BCRYPT_ROUNDS=12
MAX_SESSIONS_PER_USER=5
LOGIN_RATE_LIMIT_MAX_FAILURES=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_LOCK_MS=900000
PORT=3000
LOG_LEVEL=info
OTEL_SERVICE_NAME=elysia-api
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
DISCORD_WEBHOOK_URL=
# SMTP: Mailpit in dev/release, configured like production Gmail (implicit TLS
# + login/password); only Mailpit's self-signed certificate is not verified.
# Production Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
# SMTP_TLS_REJECT_UNAUTHORIZED=true, SMTP_USER=<gmail address>,
# SMTP_PASSWORD_FILE=<file holding the app password>.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=true
SMTP_TLS_REJECT_UNAUTHORIZED=false
SMTP_USER=ocazbike
# Shared with Mailpit by Compose; generate with: openssl rand -hex 32
SMTP_PASSWORD=
SMTP_FROM=Ocazbike <noreply@ocazbike.local>
# Private Chromium HTML-to-PDF service published by Compose on localhost:3002.
GOTENBERG_URL=http://localhost:3002
# COOKIE_SECURE=true
